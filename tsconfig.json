{
    "compilerOptions": {
        "target": "ES2024",
        "useDefineForClassFields": true,
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "paths": {
            "@/*": ["./resources/js/*"]
        }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx"]
}
